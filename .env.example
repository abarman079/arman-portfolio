# Public site origin used to verify the Turnstile response hostname.
SITE_URL=https://portfolio.example.com

# Cloudflare Turnstile widget site key (public) and Siteverify secret (server-only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Resend API key and an address on an owner-verified sending domain.
RESEND_API_KEY=re_your_resend_api_key
CONTACT_FROM_EMAIL=Portfolio Contact <contact@example.com>

# Destination inbox for contact notifications.
CONTACT_TO_EMAIL=owner@example.com
