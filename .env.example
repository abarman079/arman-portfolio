# Public canonical origin. Configure this for Vercel Production; leave it unset
# for Preview deployments so they remain protected from indexing.
SITE_URL=https://abarmandev-bay.vercel.app

# Cloudflare Turnstile widget site key (public) and Siteverify secret (server-only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Resend API key and an address on an owner-controlled, Resend-verified domain.
RESEND_API_KEY=re_your_resend_api_key
CONTACT_FROM_EMAIL=Portfolio Contact <contact@your-verified-domain.example>

# Destination inbox for contact notifications.
CONTACT_TO_EMAIL=abarmanoffice@gmail.com
